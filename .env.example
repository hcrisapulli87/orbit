# Supabase → Project Settings → API. Same project as Tandem/Tally (shared backend).
# The publishable key is a *public* browser key; the database is protected by
# Row-Level Security, not by hiding it. The real .env stays gitignored anyway.
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Web push (Phase 8). Generate with: npx web-push generate-vapid-keys
# Only the PUBLIC key belongs here — the private key goes to Supabase secrets.
VITE_VAPID_PUBLIC_KEY=
