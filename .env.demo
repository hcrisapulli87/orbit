# Demo mode: `npm run demo`.
#
# Loaded on top of .env by Vite's `--mode demo`. VITE_DEMO=1 swaps the Supabase
# client for an in-memory fake seeded with invented data, so the app runs with no
# backend, no account and no keys. The placeholders below deliberately override
# any real credentials in .env — demo mode must never be able to reach the live
# project even by accident.
#
# Safe to commit: there is nothing secret here.
VITE_DEMO=1
VITE_SUPABASE_URL=https://demo.placeholder.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_demo_placeholder

# Blanked on purpose: with no VAPID key the Settings screen reports push as
# "not configured" and the button stays disabled, so the demo can never fire a
# browser permission prompt at whoever is looking at it.
VITE_VAPID_PUBLIC_KEY=
